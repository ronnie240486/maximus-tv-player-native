<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/activationLogo"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/excellence_logo" />

        <TextView
            android:id="@+id/activationBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.16"
            android:text="EXCELLENCE"
            android:textColor="@color/cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ATIVE SEU DISPOSITIVO"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Cadastre este MAC no painel para liberar canais, filmes e séries."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/macLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="MAC DO DISPOSITIVO"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/macValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="A1B2C3D4E5F6"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/macFormatted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:text="A1:B2:C3:D4:E5:F6"
            android:textColor="@color/cyan"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/copyMacButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/activation_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="190dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="COPIAR MAC"
                android:textColor="@color/button_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recheckButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/activation_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="150dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="VERIFICAR"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/activationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Aguardando cadastro no painel..."
            android:textColor="@color/warning"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/activationHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Use o código acima no cadastro do dispositivo."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
